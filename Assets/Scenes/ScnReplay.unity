  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=130%><b><color=#FFCC00>RD-Replay \u56DE\u653E\u7CFB\u7EDF</color></b></size>\n\n<color=#FFFFFF>\u672C\u6A21\u7EC4\u4E3A\u300A\u8282\u594F\u533B\u751F\u300B\u63D0\u4F9B\u4E86\u4E00\u4E2A\u72EC\u7ACB\u7684\u3001\u53EF\u7B7E\u540D\u6821\u9A8C\u7684\u56DE\u653E\u7CFB\u7EDF\u3002</color>\n\n<color=#99CCFF>\u4E3B\u8981\u7279\u6027\uFF1A</color>\n<color=#CCCCCC>\u2022
    \u81EA\u52A8\u5F55\u5236\uFF1A\u6E38\u73A9\u4EFB\u610F\u5173\u5361\uFF08\u542B\u81EA\u5236\u5173\uFF09\u65F6\u81EA\u52A8\u8BB0\u5F55\u4F60\u7684\u8F93\u5165\u4E0E\u5224\u5B9A\u7ED3\u679C\u3002</color>\n<color=#CCCCCC>\u2022
    \u7CBE\u51C6\u56DE\u653E\uFF1A\u901A\u8FC7\u5F55\u5236 <color=#FFDD88>Rand \u7ED3\u679C</color>\u3001<color=#FFDD88>\u5224\u5B9A\u96BE\u5EA6</color>
    \u4E0E <color=#FFDD88>\u5185\u90E8\u8F93\u5165\u72B6\u6001</color>\uFF0C\u5C3D\u53EF\u80FD\u8FD8\u539F\u5F53\u65F6\u7684\u6E38\u73A9\u8FC7\u7A0B\u3002</color>\n<color=#CCCCCC>\u2022
    \u56DE\u653E\u5217\u8868\uFF1A\u5728\u8FD9\u91CC\u67E5\u770B\u3001\u64AD\u653E\u548C\u5220\u9664\u5DF2\u4FDD\u5B58\u7684\u56DE\u653E\uFF0C\u5E76\u67E5\u770B\u5206\u6570\u3001\u8BC4\u4EF7\u548C\u65F6\u957F\u7B49\u4FE1\u606F\u3002</color>\n<color=#CCCCCC>\u2022
    \u53CD\u7BE1\u6539\u7B7E\u540D\uFF1A\u56DE\u653E\u6587\u4EF6\u4F7F\u7528 <color=#FF8888>\u7B7E\u540D\u6821\u9A8C</color>\uFF0C\u9632\u6B62\u7B80\u5355\u4FEE\u6539\u56DE\u653E\u6570\u636E\u7528\u4E8E\u4F5C\u5F0A\u3002</color>\n\n<color=#99FF99>\u63A8\u8350\u7528\u6CD5\uFF1A</color>\n<color=#CCCCCC>\u2022
    \u7EC3\u4E60\u56F0\u96BE\u8C31\u9762\u65F6\uFF0C\u5F55\u4E00\u6BB5\u81EA\u5DF1\u6700\u7A33\u5B9A\u7684\u56DE\u5408\uFF0C\u518D\u901A\u8FC7\u56DE\u653E\u89C2\u5BDF\u8282\u594F\u4E0E\u504F\u79FB\u3002</color>\n<color=#CCCCCC>\u2022
    \u4E0E\u4ED6\u4EBA\u5206\u4EAB\u81EA\u5DF1\u7684\u6210\u7EE9\u4E0E\u64CD\u4F5C\u8FC7\u7A0B\uFF0C\u6216\u7528\u4E8E\u5236\u4F5C\u6559\u5B66\u89C6\u9891\uFF08\u53EF\u914D\u5408\u5F55\u5C4F\u8F6F\u4EF6\uFF09\u3002</color>\n\n<color=#AAAAFF>\u63D0\u793A\uFF1A</color>\n<color=#CCCCCC>\u2022
    \u56DE\u653E\u5B58\u50A8\u8DEF\u5F84\u4E0E\u63A7\u5236\u6761\u884C\u4E3A\u53EF\u5728\u300C\u8BBE\u7F6E\u300D\u9762\u677F\u4E2D\u81EA\u5B9A\u4E49\u3002</color>\n<color=#CCCCCC>\u2022
    \u82E5\u6E38\u620F\u7248\u672C\u66F4\u65B0\u5BFC\u81F4\u56DE\u653E\u65E0\u6CD5\u6B63\u5E38\u52A0\u8F7D\uFF0C\u8BF7\u4F18\u5148\u68C0\u67E5\u672C\u6A21\u7EC4\u7248\u672C\u662F\u5426\u5339\u914D\u3002</color>"
